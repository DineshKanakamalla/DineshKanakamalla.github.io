---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="404 — Embedded Journal">
  <div class="mx-auto max-w-2xl px-6 py-32 text-center">
    <div class="font-mono text-6xl font-semibold text-[--color-signal] mb-6">404</div>
    <h1 class="text-2xl font-semibold mb-3">Page not found</h1>
    <p class="text-[--color-muted] mb-8">
      The link is dead. Could be a bad revision, could be a bad flash.
    </p>
    <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[--color-signal] text-[#0a0a0c] font-medium text-sm hover:brightness-110 transition">
      Back to home
    </a>
  </div>
</BaseLayout>
