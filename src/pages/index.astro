---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { CATEGORIES, CATEGORY_ICONS, type CategoryKey } from '@/lib/categories';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = posts.find(p => p.data.featured) ?? posts[0];
const recent = posts.filter(p => p.id !== featured?.id).slice(0, 6);

const categoryOrder: CategoryKey[] = ['rtos', 'embedded-linux', 'wifi', 'networking', 'os', 'misc'];
const counts = Object.fromEntries(
  categoryOrder.map(k => [k, posts.filter(p => p.data.category === k).length])
) as Record<CategoryKey, number>;
---

<BaseLayout title="Embedded Journal — Practical embedded systems">
  <section class="mx-auto max-w-6xl px-6 pt-20 pb-16">
    <div class="grid lg:grid-cols-[1fr_340px] gap-12 items-center">
      <div class="max-w-3xl">
        <h1 class="text-5xl md:text-6xl font-semibold tracking-tight leading-[1.05] mb-6">
          Real hardware.<br/>
          Real numbers.<br/>
          <span class="text-[--color-signal]">Real failures.</span>
        </h1>

        <p class="text-lg md:text-xl text-[--color-muted] leading-relaxed max-w-2xl mb-10">
          An embedded systems journal with no hand-waving. Every post ships a
          repo, pins its versions, publishes its raw data, and ends with the
          failure modes you'll actually hit.
        </p>

        <div class="flex flex-wrap gap-3">
          {featured && (
            <a href={`/posts/${featured.slug}`} class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[--color-signal] text-[#09090b] font-medium text-sm hover:brightness-110 transition">
              Read the latest
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          )}
        </div>
      </div>

      <div class="hidden lg:flex justify-center">
        <svg viewBox="0 0 260 220" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-[300px] h-auto">
          <defs>
            <linearGradient id="trace-grad" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="var(--color-signal)" stop-opacity="0.1"/>
              <stop offset="50%" stop-color="var(--color-signal)" stop-opacity="0.5"/>
              <stop offset="100%" stop-color="var(--color-signal)" stop-opacity="0.1"/>
              <animate attributeName="x1" values="-100%;100%" dur="3s" repeatCount="indefinite"/>
              <animate attributeName="x2" values="0%;200%" dur="3s" repeatCount="indefinite"/>
            </linearGradient>
            <filter id="glow">
              <feGaussianBlur stdDeviation="2.5" result="coloredBlur"/>
              <feMerge>
                <feMergeNode in="coloredBlur"/>
                <feMergeNode in="SourceGraphic"/>
              </feMerge>
            </filter>
          </defs>

          <!-- Animated circuit board traces -->
          <g stroke="url(#trace-grad)" stroke-width="1.5" stroke-linecap="round">
            <path d="M30 110 H95 V60 H165"/>
            <path d="M95 110 V160 H165"/>
            <path d="M165 60 H230 V110"/>
            <path d="M165 160 H230 V110"/>
            <path d="M130 25 V60"/>
            <path d="M130 160 V195"/>
          </g>

          <!-- Static trace overlay -->
          <g stroke="var(--color-signal)" stroke-width="0.8" opacity="0.12">
            <path d="M30 110 H95 V60 H165"/>
            <path d="M95 110 V160 H165"/>
            <path d="M165 60 H230 V110"/>
            <path d="M165 160 H230 V110"/>
            <path d="M130 25 V60"/>
            <path d="M130 160 V195"/>
          </g>

          <!-- Pulsing nodes -->
          <circle cx="95" cy="110" r="3.5" fill="var(--color-signal)" filter="url(#glow)">
            <animate attributeName="opacity" values="0.5;1;0.5" dur="2s" repeatCount="indefinite"/>
          </circle>
          <circle cx="165" cy="60" r="3.5" fill="var(--color-signal)" filter="url(#glow)">
            <animate attributeName="opacity" values="0.5;1;0.5" dur="2.4s" repeatCount="indefinite"/>
          </circle>
          <circle cx="165" cy="160" r="3.5" fill="var(--color-signal)" filter="url(#glow)">
            <animate attributeName="opacity" values="0.5;1;0.5" dur="2.8s" repeatCount="indefinite"/>
          </circle>
          <circle cx="230" cy="110" r="3.5" fill="var(--color-signal)" filter="url(#glow)">
            <animate attributeName="opacity" values="0.5;1;0.5" dur="2.2s" repeatCount="indefinite"/>
          </circle>
          <circle cx="130" cy="60" r="2.5" fill="var(--color-signal)" filter="url(#glow)">
            <animate attributeName="opacity" values="0.4;1;0.4" dur="3s" repeatCount="indefinite"/>
          </circle>
          <circle cx="130" cy="160" r="2.5" fill="var(--color-signal)" filter="url(#glow)">
            <animate attributeName="opacity" values="0.4;1;0.4" dur="2.6s" repeatCount="indefinite"/>
          </circle>

          <!-- Central chip -->
          <rect x="95" y="75" width="70" height="70" rx="7" stroke="var(--color-signal)" stroke-width="1.5" fill="var(--color-surface)" filter="url(#glow)">
            <animate attributeName="stroke-opacity" values="0.6;1;0.6" dur="3s" repeatCount="indefinite"/>
          </rect>
          <rect x="108" y="88" width="44" height="44" rx="4" fill="var(--color-signal)" opacity="0.12">
            <animate attributeName="opacity" values="0.08;0.2;0.08" dur="2s" repeatCount="indefinite"/>
          </rect>
          <text x="130" y="114" text-anchor="middle" font-family="monospace" font-size="12" font-weight="bold" fill="var(--color-signal)" opacity="0.9">&gt;_</text>

          <!-- Expanding pulse rings -->
          <circle cx="130" cy="110" r="35" stroke="var(--color-signal)" stroke-width="0.8" fill="none" opacity="0">
            <animate attributeName="r" values="35;70" dur="3s" repeatCount="indefinite"/>
            <animate attributeName="opacity" values="0.3;0" dur="3s" repeatCount="indefinite"/>
          </circle>
          <circle cx="130" cy="110" r="35" stroke="var(--color-signal)" stroke-width="0.8" fill="none" opacity="0">
            <animate attributeName="r" values="35;70" dur="3s" begin="1.5s" repeatCount="indefinite"/>
            <animate attributeName="opacity" values="0.2;0" dur="3s" begin="1.5s" repeatCount="indefinite"/>
          </circle>

          <!-- Data flow particles -->
          <circle r="2" fill="var(--color-signal)" filter="url(#glow)" opacity="0.9">
            <animateMotion dur="1.8s" repeatCount="indefinite" path="M30 110 H95 V60 H165"/>
          </circle>
          <circle r="1.8" fill="var(--color-signal)" filter="url(#glow)" opacity="0.8">
            <animateMotion dur="2s" repeatCount="indefinite" path="M165 60 H230 V110"/>
          </circle>
          <circle r="1.8" fill="var(--color-signal)" filter="url(#glow)" opacity="0.7">
            <animateMotion dur="2.2s" repeatCount="indefinite" path="M130 25 V60"/>
          </circle>
          <circle r="1.5" fill="var(--color-signal)" filter="url(#glow)" opacity="0.6">
            <animateMotion dur="2.5s" repeatCount="indefinite" path="M165 160 H230 V110"/>
          </circle>
          <circle r="1.5" fill="var(--color-signal)" filter="url(#glow)" opacity="0.5">
            <animateMotion dur="2.8s" repeatCount="indefinite" path="M95 110 V160 H165"/>
          </circle>

          <!-- Scanning line -->
          <line x1="30" y1="0" x2="230" y2="0" stroke="var(--color-signal)" stroke-width="0.8" opacity="0.15">
            <animate attributeName="y1" values="10;210;10" dur="4s" repeatCount="indefinite"/>
            <animate attributeName="y2" values="10;210;10" dur="4s" repeatCount="indefinite"/>
            <animate attributeName="opacity" values="0;0.2;0" dur="4s" repeatCount="indefinite"/>
          </line>
        </svg>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-20">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
      {categoryOrder.map((key) => {
        const c = CATEGORIES[key];
        const icon = CATEGORY_ICONS[key];
        return (
          <a
            href={`/categories/${key}`}
            class="group rounded-xl border border-[--color-border] bg-[--color-surface] p-4 transition-all hover:border-[--color-border-hi] hover:-translate-y-0.5 hover:shadow-[var(--shadow-card)]"
          >
            <div class="mb-3 transition-transform group-hover:scale-110" style={`color:${c.color}`} set:html={icon} />
            <div class="font-medium text-sm mb-1 group-hover:text-[--color-signal] transition-colors">{c.label}</div>
            <div class="text-xs font-mono text-[--color-subtle]">{counts[key]} {counts[key] === 1 ? 'post' : 'posts'}</div>
          </a>
        );
      })}
    </div>
  </section>

  {featured && (
    <section class="mx-auto max-w-6xl px-6 pb-16">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-xs font-mono uppercase tracking-widest text-[--color-subtle]">Featured</span>
        <div class="flex-1 h-px bg-[--color-border]"></div>
      </div>
      <PostCard post={featured} featured />
    </section>
  )}

  <section class="mx-auto max-w-6xl px-6 pb-24">
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-3 flex-1">
        <span class="text-xs font-mono uppercase tracking-widest text-[--color-subtle]">Recent</span>
        <div class="flex-1 h-px bg-[--color-border]"></div>
      </div>
      <a href="/posts" class="ml-4 text-xs font-mono text-[--color-muted] hover:text-[--color-signal]">All posts →</a>
    </div>
    <div class="grid md:grid-cols-2 gap-4">
      {recent.map(post => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
