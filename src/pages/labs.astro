---
import BaseLayout from '@/layouts/BaseLayout.astro';

const labs = [
  {
    slug: 'zephyr-blink',
    title: 'Zephyr blink on Nucleo-F446RE',
    lang: 'C / CMake',
    loc: 32,
    test: 'Zephyr 3.7.0',
    repo: 'https://github.com/DineshKanakamalla/labs/tree/main/zephyr-blink',
    post: '/posts/zephyr-blink',
  },
  {
    slug: 'freertos-prio-inversion',
    title: 'FreeRTOS priority inversion, minimal repro',
    lang: 'C',
    loc: 118,
    test: 'FreeRTOS 11.1.0',
    repo: 'https://github.com/DineshKanakamalla/labs/tree/main/freertos-prio-inversion',
    post: '/posts/freertos-prio-inversion',
  },
];
---

<BaseLayout title="Labs — Embedded Journal">
  <div class="mx-auto max-w-6xl px-6 pt-16 pb-24">
    <header class="mb-12 max-w-2xl">
      <div class="text-xs font-mono uppercase tracking-widest text-[--color-subtle] mb-3">Labs</div>
      <h1 class="text-4xl font-semibold tracking-tight mb-4">Every post, as runnable code</h1>
      <p class="text-lg text-[--color-muted] leading-relaxed">
        Each directory is a self-contained lab with a five-command reproduce section.
        Clone, build, flash, measure. If it doesn't work, open an issue — that's the point.
      </p>
    </header>

    <div class="rounded-xl border border-[--color-border] bg-[--color-surface] overflow-hidden shadow-[var(--shadow-card)]">
      <div class="grid grid-cols-[1fr_auto_auto_auto] gap-4 px-5 py-3 border-b border-[--color-border] text-[10px] font-mono uppercase tracking-widest text-[--color-subtle]">
        <span>Lab</span>
        <span>Stack</span>
        <span>LOC</span>
        <span></span>
      </div>
      {labs.map((lab, i) => (
        <div class="grid grid-cols-[1fr_auto_auto_auto] gap-4 items-center px-5 py-4 border-b border-[--color-border] last:border-0 hover:bg-[--color-elevated] transition-colors group fade-in-up" style={`animation-delay: ${i * 0.05}s`}>
          <div class="min-w-0">
            <a href={lab.post} class="font-medium text-[--color-text] hover:text-[--color-signal] transition-colors block truncate">{lab.title}</a>
            <div class="text-xs font-mono text-[--color-subtle] mt-0.5">{lab.test}</div>
          </div>
          <span class="text-xs font-mono text-[--color-muted]">{lab.lang}</span>
          <span class="text-xs font-mono text-[--color-muted] tabular-nums">{lab.loc}</span>
          <a href={lab.repo} target="_blank" rel="noopener" class="text-[--color-muted] hover:text-[--color-signal] transition-colors" aria-label={`Source for ${lab.title}`}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.4 3.6 1 .1-.8.4-1.4.8-1.7-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
