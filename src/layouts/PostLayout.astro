---
import BaseLayout from './BaseLayout.astro';
import CategoryBadge from '@/components/CategoryBadge.astro';
import TOC from '@/components/TOC.astro';
import AuthorCard from '@/components/AuthorCard.astro';
import { CATEGORIES, POST_TYPES, DIFFICULTY } from '@/lib/categories';
import { readingTime, formatDate, isoDate } from '@/lib/reading-time';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { Content, headings } = await post.render();
const cat = CATEGORIES[post.data.category];
const type = POST_TYPES[post.data.postType];
const diff = DIFFICULTY[post.data.difficulty];
const minutes = readingTime(post.body);
---

<BaseLayout title={`${post.data.title} — Embedded Journal`} description={post.data.summary} showProgress>
  <article class="mx-auto max-w-6xl px-6 pt-12 pb-24">
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-2 mb-6">
        <CategoryBadge category={post.data.category} />
        <span class="text-xs font-mono px-2.5 py-1 rounded-full border" style={`color:${cat.color};border-color:${cat.color}40;background:${cat.color}0d`}>
          {type.glyph} {type.label}
        </span>
        <span class="text-xs font-mono px-2.5 py-1 rounded-full border" style={`color:${diff.color};border-color:${diff.color}40`}>
          {diff.label}
        </span>
      </div>

      <h1 class="text-4xl md:text-5xl font-semibold tracking-tight leading-[1.1] mb-5">
        {post.data.title}
      </h1>

      <p class="text-lg text-[--color-muted] leading-relaxed mb-8 max-w-3xl">
        {post.data.summary}
      </p>

      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-[--color-muted] font-mono pb-6 border-b border-[--color-border]">
        <span class="flex items-center gap-1.5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
        </span>
        <span class="flex items-center gap-1.5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {minutes} min read
        </span>
        {post.data.series && (
          <span class="flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            Series: {post.data.series}
          </span>
        )}
      </div>
    </header>

    {(post.data.repo || post.data.bomCost) && (
      <div class="max-w-3xl mx-auto my-8 flex flex-wrap items-center gap-3 rounded-xl border border-[--color-border] bg-[--color-surface] px-4 py-3">
        {post.data.repo && (
          <a href={post.data.repo} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm font-mono text-[--color-signal] hover:underline">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.4 3.6 1 .1-.8.4-1.4.8-1.7-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>
            View source
          </a>
        )}
        {post.data.bomCost && (
          <span class="text-sm font-mono text-[--color-muted]">BOM: <span class="text-[--color-text]">{post.data.bomCost}</span></span>
        )}
      </div>
    )}

    <div class="max-w-3xl mx-auto lg:grid lg:grid-cols-[minmax(0,1fr)_200px] lg:gap-12 lg:max-w-5xl">
      <div class="prose-custom min-w-0">
        <Content />
      </div>

      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <TOC headings={headings} />
        </div>
      </aside>
    </div>

    {post.data.tags.length > 0 && (
      <div class="max-w-3xl mx-auto mt-16 pt-8 border-t border-[--color-border]">
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <a href={`/tags/${tag}`} class="text-xs font-mono px-3 py-1.5 rounded-full border border-[--color-border] bg-[--color-surface] text-[--color-muted] hover:border-[--color-signal] hover:text-[--color-signal] transition-colors">
              #{tag}
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="max-w-3xl mx-auto mt-12 grid gap-6 sm:grid-cols-2">
      <AuthorCard />
      <div class="flex flex-col gap-3 p-5 rounded-xl border border-[--color-border] bg-[--color-surface]">
        <div class="text-xs font-mono uppercase tracking-widest text-[--color-subtle]">Share this post</div>
        <div class="flex gap-2">
          <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener" class="flex items-center gap-2 px-3 py-2 rounded-lg border border-[--color-border] bg-[--color-elevated] text-sm text-[--color-muted] hover:text-[--color-signal] hover:border-[--color-signal] transition-all">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            Post
          </a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener" class="flex items-center gap-2 px-3 py-2 rounded-lg border border-[--color-border] bg-[--color-elevated] text-sm text-[--color-muted] hover:text-[--color-signal] hover:border-[--color-signal] transition-all">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
          <button
            type="button"
            data-copy-url={Astro.url.href}
            class="flex items-center gap-2 px-3 py-2 rounded-lg border border-[--color-border] bg-[--color-elevated] text-sm text-[--color-muted] hover:text-[--color-signal] hover:border-[--color-signal] transition-all cursor-pointer"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            Copy link
          </button>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll('[data-copy-url]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = (btn as HTMLElement).dataset.copyUrl;
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
        const svg = btn.querySelector('svg');
        const originalHTML = btn.innerHTML;
        btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Copied!`;
        setTimeout(() => { btn.innerHTML = originalHTML; }, 2000);
      } catch {}
    });
  });
</script>
