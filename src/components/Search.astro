---
---
<div id="search-overlay" class="fixed inset-0 z-50 hidden items-start justify-center pt-[15vh] px-4 bg-black/60 backdrop-blur-sm">
  <div id="search-dialog" class="w-full max-w-2xl rounded-2xl border border-[--color-border-hi] bg-[--color-surface] shadow-[var(--shadow-lg)] overflow-hidden" role="dialog" aria-modal="true" aria-label="Search">
    <div class="flex items-center gap-3 px-5 py-4 border-b border-[--color-border]">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[--color-muted] shrink-0"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      <input
        id="search-input"
        type="search"
        placeholder="Search posts, tags, hardware…"
        class="flex-1 bg-transparent border-none outline-none text-[--color-text] placeholder:text-[--color-subtle] text-base"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="text-[10px] font-mono px-2 py-1 rounded border border-[--color-border] text-[--color-subtle]">ESC</kbd>
    </div>
    <div id="search-results" class="max-h-[60vh] overflow-y-auto p-2">
      <div class="px-4 py-8 text-center text-sm text-[--color-subtle]">Type to search…</div>
    </div>
    <div class="px-5 py-2.5 border-t border-[--color-border] flex items-center justify-between text-[10px] font-mono text-[--color-subtle] uppercase tracking-widest">
      <div class="flex items-center gap-3">
        <span class="flex items-center gap-1"><kbd class="px-1.5 py-0.5 rounded border border-[--color-border] bg-[--color-elevated]">↑</kbd><kbd class="px-1.5 py-0.5 rounded border border-[--color-border] bg-[--color-elevated]">↓</kbd> navigate</span>
        <span class="flex items-center gap-1"><kbd class="px-1.5 py-0.5 rounded border border-[--color-border] bg-[--color-elevated]">↵</kbd> open</span>
      </div>
      <span class="flex items-center gap-1"><kbd class="px-1.5 py-0.5 rounded border border-[--color-border] bg-[--color-elevated]">esc</kbd> close</span>
    </div>
  </div>
</div>

<style>
  #search-overlay.open { display: flex; }
</style>

<script>
  type Result = { url: string; meta: { title: string }; excerpt: string };

  const overlay = document.getElementById('search-overlay')!;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const resultsEl = document.getElementById('search-results')!;

  let pagefind: any = null;
  let selected = -1;

  async function load() {
    if (pagefind) return pagefind;
    // @ts-ignore
    const pfPath = '/pagefind/pagefind.js';
      pagefind = await import(/* @vite-ignore */ pfPath);
    await pagefind.init();
    return pagefind;
  }

  function open() {
    overlay.classList.add('open');
    input.value = '';
    resultsEl.innerHTML = '<div class="px-4 py-8 text-center text-sm text-[--color-subtle]">Type to search…</div>';
    selected = -1;
    requestAnimationFrame(() => input.focus());
    load();
  }

  function close() {
    overlay.classList.remove('open');
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });

  window.addEventListener('open-search', open);
  document.querySelectorAll('[data-search-open]').forEach((el) => el.addEventListener('click', open));
  overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });

  let timer: number | undefined;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(async () => {
      const q = input.value.trim();
      if (!q) {
        resultsEl.innerHTML = '<div class="px-4 py-8 text-center text-sm text-[--color-subtle]">Type to search…</div>';
        return;
      }
      const pf = await load();
      const search = await pf.search(q);
      const results: Result[] = await Promise.all(search.results.slice(0, 10).map((r: any) => r.data()));

      if (!results.length) {
        resultsEl.innerHTML = `<div class="px-4 py-8 text-center text-sm text-[--color-subtle]">No results for "${q}"</div>`;
        return;
      }

      selected = 0;
      resultsEl.innerHTML = results.map((r, i) => `
        <a href="${r.url}" class="search-result block px-4 py-3 rounded-lg hover:bg-[--color-elevated] transition-colors duration-150 ${i === 0 ? 'bg-[--color-elevated]' : ''}">
          <div class="font-medium text-sm text-[--color-text] mb-1">${r.meta.title}</div>
          <div class="text-xs text-[--color-muted] line-clamp-2">${r.excerpt}</div>
        </a>
      `).join('');
    }, 150);
  });

  input.addEventListener('keydown', (e) => {
    const items = resultsEl.querySelectorAll<HTMLAnchorElement>('.search-result');
    if (!items.length) return;
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      selected = Math.min(selected + 1, items.length - 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      selected = Math.max(selected - 1, 0);
    } else if (e.key === 'Enter' && selected >= 0) {
      e.preventDefault();
      items[selected].click();
      return;
    } else return;

    items.forEach((it, i) => it.classList.toggle('bg-[--color-elevated]', i === selected));
    items[selected].scrollIntoView({ block: 'nearest' });
  });
</script>
