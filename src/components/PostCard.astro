---
import CategoryBadge from './CategoryBadge.astro';
import { CATEGORIES, POST_TYPES, DIFFICULTY } from '@/lib/categories';
import { readingTime, formatDate } from '@/lib/reading-time';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
const type = POST_TYPES[post.data.postType];
const diff = DIFFICULTY[post.data.difficulty];
const cat = CATEGORIES[post.data.category];
const minutes = readingTime(post.body);
---

<a
  href={`/posts/${post.slug}`}
  class:list={[
    'group block rounded-2xl border bg-[--color-surface] transition-all duration-300 overflow-hidden',
    'hover:border-[--color-border-hi] hover:bg-[--color-elevated] hover:-translate-y-0.5',
    'hover:shadow-[var(--shadow-card-hover)]',
    featured
      ? 'border-transparent shadow-[var(--shadow-card)] ring-1 ring-[--color-border]'
      : 'border-[--color-border]',
  ]}
  style={featured ? `--tw-ring-color:${cat.color}40` : undefined}
>
  {featured && (
    <div class="h-1 w-full" style={`background:linear-gradient(90deg, ${cat.color}, var(--color-signal))`}></div>
  )}
  <div class:list={['p-6', featured && 'md:p-8']}>
    <div class="flex items-center gap-2 mb-4">
      <CategoryBadge category={post.data.category} asLink={false} />
      <span class="text-xs font-mono text-[--color-subtle]">{type.glyph} {type.label}</span>
    </div>

    <h3 class:list={[
      'font-semibold tracking-tight mb-3 group-hover:text-[--color-signal] transition-colors duration-200',
      featured ? 'text-2xl md:text-3xl' : 'text-lg',
    ]}>
      {post.data.title}
    </h3>

    <p class:list={[
      'text-[--color-muted] leading-relaxed mb-5',
      featured ? 'text-base line-clamp-3' : 'text-sm line-clamp-2',
    ]}>
      {post.data.summary}
    </p>

    <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-[--color-subtle]">
      <span class="flex items-center gap-1">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </span>
      <span class="w-1 h-1 rounded-full bg-[--color-border-hi]"></span>
      <span class="flex items-center gap-1">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        {minutes} min read
      </span>
      <span class="w-1 h-1 rounded-full bg-[--color-border-hi]"></span>
      <span style={`color:${diff.color}`}>{diff.label}</span>
      {post.data.bomCost && (
        <>
          <span class="w-1 h-1 rounded-full bg-[--color-border-hi]"></span>
          <span class="flex items-center gap-1">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            {post.data.bomCost}
          </span>
        </>
      )}
    </div>
  </div>
</a>
