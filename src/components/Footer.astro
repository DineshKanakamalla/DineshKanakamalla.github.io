---
import { getCollection } from 'astro:content';
const year = new Date().getFullYear();

const recentPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<footer class="mt-24">
  <div class="h-px bg-gradient-to-r from-transparent via-[--color-border] to-transparent"></div>
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-12 md:grid-cols-3">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <div class="flex items-center gap-2.5 mb-4">
          <span class="w-7 h-7 rounded-lg bg-gradient-to-br from-[--color-signal] to-[--color-signal-dim] flex items-center justify-center text-[#09090b] font-mono font-bold text-xs">
            &gt;_
          </span>
          <span class="font-semibold tracking-tight">
            Embedded<span class="text-[--color-signal]">.</span>Journal
          </span>
        </div>
        <p class="text-sm text-[--color-muted] leading-relaxed max-w-xs mb-5">
          Practical embedded systems. Real hardware, real numbers, real failures.
        </p>
        <div class="flex gap-2">
          <a href="https://github.com/DineshKanakamalla" target="_blank" rel="noopener" class="w-9 h-9 rounded-lg border border-[--color-border] bg-[--color-surface] flex items-center justify-center text-[--color-muted] hover:text-[--color-signal] hover:border-[--color-signal] transition-all" aria-label="GitHub">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.4 3.6 1 .1-.8.4-1.4.8-1.7-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>
          </a>
          <a href="https://www.linkedin.com/in/siva-dinesh-kanakamalla-28b863214" target="_blank" rel="noopener" class="w-9 h-9 rounded-lg border border-[--color-border] bg-[--color-surface] flex items-center justify-center text-[--color-muted] hover:text-[--color-signal] hover:border-[--color-signal] transition-all" aria-label="LinkedIn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="mailto:dineshkanakamalla078@gmail.com" class="w-9 h-9 rounded-lg border border-[--color-border] bg-[--color-surface] flex items-center justify-center text-[--color-muted] hover:text-[--color-signal] hover:border-[--color-signal] transition-all" aria-label="Email">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </a>
          <a href="/rss.xml" class="w-9 h-9 rounded-lg border border-[--color-border] bg-[--color-surface] flex items-center justify-center text-[--color-muted] hover:text-[--color-signal] hover:border-[--color-signal] transition-all" aria-label="RSS">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
          </a>
        </div>
      </div>

      <!-- Recent Posts -->
      <div>
        <div class="text-xs uppercase tracking-widest text-[--color-subtle] font-mono mb-4">Recent posts</div>
        <ul class="space-y-3">
          {recentPosts.map((post) => (
            <li>
              <a href={`/posts/${post.slug}`} class="text-sm text-[--color-muted] hover:text-[--color-signal] transition-colors leading-relaxed block line-clamp-2">
                {post.data.title}
              </a>
              <time class="text-xs font-mono text-[--color-subtle]" datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
              </time>
            </li>
          ))}
        </ul>
      </div>

      <!-- Explore -->
      <div>
        <div class="text-xs uppercase tracking-widest text-[--color-subtle] font-mono mb-4">Explore</div>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/" class="text-[--color-muted] hover:text-[--color-signal] transition-colors duration-200">Home</a></li>
          <li><a href="/posts" class="text-[--color-muted] hover:text-[--color-signal] transition-colors duration-200">All posts</a></li>
          <li><a href="/labs" class="text-[--color-muted] hover:text-[--color-signal] transition-colors duration-200">Labs</a></li>
          <li><a href="/about" class="text-[--color-muted] hover:text-[--color-signal] transition-colors duration-200">About</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-14 pt-6 border-t border-[--color-border] flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-[--color-subtle]">
      <span>&copy; {year} Embedded Journal &mdash; All measurements are mine. Results may vary with silicon.</span>
      <span>Built with Astro &middot; Hosted on Cloudflare</span>
    </div>
  </div>
</footer>
