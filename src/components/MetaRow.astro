---
interface Props { label: string; items: string[] }
const { label, items } = Astro.props;
---
<div class="rounded-xl border border-[--color-border] bg-[--color-surface] px-4 py-3 shadow-[var(--shadow-card)]">
  <div class="text-[10px] uppercase tracking-widest text-[--color-subtle] mb-1.5 font-mono">{label}</div>
  <ul class="space-y-0.5">
    {items.map(i => (
      <li class="text-sm text-[--color-text]">{i}</li>
    ))}
  </ul>
</div>
