---
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { href: '/categories/os', label: 'OS' },
  { href: '/categories/embedded-linux', label: 'Embedded Linux' },
  { href: '/categories/rtos', label: 'RTOS' },
  { href: '/categories/networking', label: 'Networking' },
  { href: '/categories/wifi', label: 'Wi-Fi' },
  { href: '/categories/misc', label: 'Misc' },
];
const current = Astro.url.pathname;
---

<header class="sticky top-0 z-40 backdrop-blur-xl bg-[color-mix(in_oklab,var(--color-bg)_75%,transparent)] border-b border-[--color-border]">
  <div class="mx-auto max-w-6xl px-6 h-16 flex items-center justify-between gap-6">
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-2.5 group shrink-0">
        <span class="w-7 h-7 rounded-lg bg-gradient-to-br from-[--color-signal] to-[--color-signal-dim] flex items-center justify-center text-[#09090b] font-mono font-bold text-xs group-hover:shadow-[var(--shadow-glow)] transition-shadow duration-300">
          &gt;_
        </span>
        <span class="font-semibold tracking-tight hidden sm:block">
          Embedded<span class="text-[--color-signal]">.</span>Journal
        </span>
      </a>

      <nav class="hidden md:flex items-center gap-1">
        {nav.map((item) => {
          const active = current.startsWith(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                'relative px-3 py-1.5 rounded-md text-sm font-medium transition-colors',
                active
                  ? 'text-[--color-signal]'
                  : 'text-[--color-muted] hover:text-[--color-text]',
              ]}
            >
              {item.label}
              {active && (
                <span class="absolute inset-x-1 -bottom-[1px] h-px bg-[--color-signal] rounded-full"></span>
              )}
            </a>
          );
        })}
      </nav>
    </div>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-search-open
        class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-[--color-border] bg-[--color-surface]/60 backdrop-blur-sm text-[--color-muted] hover:text-[--color-text] hover:border-[--color-border-hi] transition-all text-sm"
        aria-label="Open search"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <span class="font-mono text-xs hidden sm:inline">⌘K</span>
      </button>
      <ThemeToggle />
      <button
        type="button"
        data-mobile-menu-toggle
        class="md:hidden flex items-center justify-center w-9 h-9 rounded-lg border border-[--color-border] bg-[--color-surface]/60 text-[--color-muted] hover:text-[--color-text] hover:border-[--color-border-hi] transition-all"
        aria-label="Toggle menu"
      >
        <svg data-menu-icon width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg data-close-icon class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-[--color-border] bg-[--color-bg]">
    <nav class="mx-auto max-w-6xl px-6 py-4 flex flex-col gap-1">
      {nav.map((item) => {
        const active = current.startsWith(item.href);
        return (
          <a
            href={item.href}
            class:list={[
              'px-3 py-2.5 rounded-lg text-sm font-medium transition-colors',
              active
                ? 'text-[--color-signal] bg-[--color-signal]/10'
                : 'text-[--color-muted] hover:text-[--color-text] hover:bg-[--color-surface]',
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-mobile-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = toggle?.querySelector('[data-menu-icon]');
  const closeIcon = toggle?.querySelector('[data-close-icon]');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('open');
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('open');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  // Close on navigation
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      menu?.classList.remove('open');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });
</script>
