---
interface Props {
  type?: 'note' | 'tip' | 'warn' | 'gotcha' | 'hw' | 'deep';
  title?: string;
}
const { type = 'note', title } = Astro.props;

const S = {
  note:   { label: 'Note',        color: '#94a3b8', icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>` },
  tip:    { label: 'Tip',         color: '#22d3ee', icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>` },
  warn:   { label: 'Warning',     color: '#fbbf24', icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>` },
  gotcha: { label: 'Gotcha',      color: '#fb7185', icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>` },
  hw:     { label: 'Hardware',    color: '#38bdf8', icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>` },
  deep:   { label: 'Deep dive',   color: '#a78bfa', icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>` },
} as const;
const s = S[type];
---
<aside
  class="my-6 rounded-xl border-l-[4px] px-5 py-4 transition-all duration-200 hover:shadow-[0_0_20px_-8px_var(--glow)]"
  style={`border-color:${s.color};background:color-mix(in oklab, ${s.color} 8%, var(--color-surface));--glow:${s.color}`}
>
  <div class="flex items-center gap-2 mb-2 font-mono text-xs uppercase tracking-widest" style={`color:${s.color}`}>
    <span aria-hidden="true" class="[&>svg]:w-[14px] [&>svg]:h-[14px]" set:html={s.icon} />
    <span>{title ?? s.label}</span>
  </div>
  <div class="text-[0.95rem] leading-relaxed text-[--color-text] [&>*:first-child]:mt-0 [&>*:last-child]:mb-0 [&>p]:my-2">
    <slot />
  </div>
</aside>
