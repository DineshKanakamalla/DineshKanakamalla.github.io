---
interface Props { src: string; alt: string; caption?: string }
const { src, alt, caption } = Astro.props;
---
<figure class="my-8">
  <img src={src} alt={alt} loading="lazy" decoding="async" class="w-full rounded-xl border border-[--color-border] shadow-[var(--shadow-card)]" />
  {caption && <figcaption class="mt-3 text-xs text-[--color-muted] text-center font-mono">{caption}</figcaption>}
</figure>
