---
interface Item { part: string; qty: number; price: number; note?: string }
interface Props { items: Item[]; title?: string }
const { items, title = 'Bill of Materials' } = Astro.props;
const total = items.reduce((s, i) => s + i.price * i.qty, 0);
---
<div class="my-8 rounded-xl border border-[--color-border] bg-[--color-surface] overflow-hidden shadow-[var(--shadow-card)]">
  <div class="px-5 py-3 border-b border-[--color-border] flex items-center gap-2">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[--color-amber]"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
    <span class="text-xs font-mono uppercase tracking-widest text-[--color-muted]">{title}</span>
  </div>
  <ul class="divide-y divide-[--color-border]">
    {items.map(i => (
      <li class="flex items-baseline justify-between gap-4 px-5 py-2.5 text-sm font-mono">
        <span class="text-[--color-text]">
          <span class="text-[--color-subtle]">{i.qty}×</span> {i.part}
          {i.note && <span class="text-[--color-subtle] text-xs ml-2">— {i.note}</span>}
        </span>
        <span class="text-[--color-muted] tabular-nums shrink-0">${(i.price * i.qty).toFixed(2)}</span>
      </li>
    ))}
  </ul>
  <div class="flex items-baseline justify-between px-5 py-3 border-t border-[--color-border] font-mono text-sm bg-[--color-elevated]">
    <span class="text-[--color-muted] uppercase tracking-widest text-xs">Total</span>
    <span class="font-semibold text-[--color-signal] tabular-nums">${total.toFixed(2)}</span>
  </div>
</div>
